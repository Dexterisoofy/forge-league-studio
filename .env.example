# ==============================================================================
# ForgeLeague — Environment Variables Example
# Copy this file to `.env` or `.env.local` for local development.
# NEVER commit `.env` or `.env.local` containing real keys to version control.
# ==============================================================================

# Backend provider: "local" (guest/demo localStorage), "supabase", or "firebase"
VITE_BACKEND_PROVIDER=local

# Optional public app base URL used when generating shareable links
VITE_APP_BASE_URL=http://localhost:5173/

# ------------------------------------------------------------------------------
# Supabase Configuration (required if VITE_BACKEND_PROVIDER=supabase)
# Find these in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# Firebase Configuration (required if VITE_BACKEND_PROVIDER=firebase)
# Find these in Firebase Console -> Project Settings -> General -> Your Apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
